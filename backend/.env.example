MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.YOUR_ID.mongodb.net/job-tracker?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-string-in-production
PORT=5001

# Gmail import — Google Cloud Console: enable Gmail API, OAuth 2.0 Client ID (Web).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/email-callback

# How much of Gmail to list per “Sync” click (paginated, newest first). Raise to scan deeper history.
GMAIL_SYNC_MAX_MESSAGES=10000

# Parallel Gmail metadata fetches per batch (default 12). Higher = faster until Google rate-limits (~10–20 is safe).
# GMAIL_SYNC_CONCURRENCY=12

# Gmail search query — default is entire Inbox. Examples:
#   in:inbox newer_than:365d
#   in:inbox OR in:sent
# GMAIL_SYNC_QUERY=in:inbox

# Optional — AI chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
